        "importedWeights": [400, 500, 600, 700]
      },
      "monoNum": {
        "cssVariables": ["--font-mono-num", "--font-mono"],
        "utilityClass": "font-mono-num",
        "stack": "\"JetBrains Mono\", monospace",
        "fontVariantNumeric": "tabular-nums",
        "importedWeights": [400, 500]
      }
    },
