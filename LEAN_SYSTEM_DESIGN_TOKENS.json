{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brandName": "Lean System",
    "stylizedWordmark": "LEAN",
    "canonicalUrl": "https://www.leansystem.co/",
    "location": "Hyderabad, Telangana, India",
    "areaServed": "India",
    "industry": "Real Estate Lead Generation, Conversion Landing Pages, and CRM Tracking Pipelines",
    "stack": {
      "framework": "React 19.0.1 + TypeScript ~5.8.2 + Vite 6.2.3",
      "styling": "Tailwind CSS v4.1.14 (@tailwindcss/vite)",
      "animation": "motion 12.23.24 + CSS Keyframes + requestAnimationFrame",
      "webgl": "three 0.184.0"
    },
    "sourceBasis": "Extracted strictly from live project source files without modification or invention."
  },
  "color": {
    "brandTheme": {
      "dark": {
        "cssVariable": "--color-brand-dark",
        "tailwindToken": "brand-dark",
        "value": "#0F0F11",
        "rgb": "rgb(15, 15, 17)",
        "usage": [
          "Global body text color (src/index.css)",
          "Primary display heading text (text-brand-dark)",
          "Global footer background (src/components/Footer.tsx)",
          "Closing CTA dark banners (AboutPremium.tsx, ServicesPremium.tsx)",
          "Private business card page background (HelloPrivateCard.tsx)",
          "Standard plan & blog CTA button background"
        ]
      },
      "navy": {
        "cssVariable": "--color-brand-navy",
        "tailwindToken": "brand-navy",
        "value": "#151B26",
        "rgb": "rgb(21, 27, 38)",
        "usage": [
          "Homepage FAQ question headings (src/App.tsx)",
          "Direct contact option card headings (src/components/LeadPortal.tsx)"
        ]
      },
      "orange": {
        "cssVariable": "--color-brand-orange",
        "tailwindToken": "brand-orange",
        "value": "#FF7A1A",
        "rgb": "rgb(255, 122, 26)",
        "usage": [
          "Primary hero CTA button & typewriter rotating headline + caret (MinimalHero.tsx)",
          "Header pill CTA gradient start & active nav link/underline (Header.tsx)",
          "Form input focus borders (LeadPortal.tsx, Footer.tsx)",
          "Section eyebrow accents & 404 CTA (App.tsx, ContactPremium.tsx, LeadPortal.tsx)",
          "Component-scoped text selection highlight (selection:bg-brand-orange)"
        ]
      },
      "light": {
        "cssVariable": "--color-brand-light",
        "tailwindToken": "brand-light",
        "value": "#F8F9FA",
        "rgb": "rgb(248, 249, 250)",
        "usage": [
          "Primary architectural off-white section & page surface (ServicesBento, AboutPremium, ServicesPremium, BlogPremium, ContactPremium, 404 view)",
          "LeadPortal form container surface"
        ]
      },
      "gray": {
        "cssVariable": "--color-brand-gray",
        "tailwindToken": "brand-gray",
        "value": "#8A94A6",
        "rgb": "rgb(138, 148, 166)",
        "usage": [
          "Homepage FAQ section subtitle & expanded answer text (src/App.tsx)",
          "LeadPortal section subtitle (src/components/LeadPortal.tsx)"
        ]
      }
    },
    "componentExplicitHex": {
      "solarOrange": {
        "value": "#FF6B00",
        "rgb": "rgb(255, 107, 0)",
        "threeHex": "0xff6b00",
        "usage": [
          "KPI metric counters and icons (MetricsGlass.tsx)",
          "Bento card icons, checkmarks, and SVG ROAS chart (ServicesBento.tsx)",
          "Timeline active phase badge, borders, checkmarks, and icons (HowItWorksTimeline.tsx)",
          "Section eyebrows, Growth tier highlight & CTA, dark banner primary CTAs (AboutPremium.tsx, ServicesPremium.tsx)",
          "Blog category read-time badge & executive brief left border (BlogPremium.tsx)",
          "Three.js point/directional lights, spheres, rings, and cube wireframes (AboutPremium.tsx)"
